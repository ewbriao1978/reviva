# =============================================================================
# .env.example - Variaveis de ambiente do backend
# =============================================================================
# Copie este arquivo para .env antes de rodar o projeto:
#
#     cp .env.example .env
#
# Os valores abaixo sao os MESMOS usados no desenvolvimento local e funcionam
# direto, sem precisar alterar nada. Isso e proposital, para facilitar a
# instalacao do MVP.
#
# ATENCAO: eles so valem para um banco local (localhost). Nao sao segredos
# reais - a senha "reviva123" pertence a um PostgreSQL que roda apenas na sua
# maquina. Se um dia a plataforma for publicada na internet, a JWT_SECRET e a
# senha do banco PRECISAM ser trocadas por valores longos e aleatorios.
#
# O arquivo .env (sem o ".example") nunca deve ser enviado ao Git.
# =============================================================================

# Conexao com o PostgreSQL, no formato:
# postgresql://USUARIO:SENHA@ENDERECO:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://reviva:reviva123@localhost:5432/reviva_db?schema=public"

# Banco auxiliar usado apenas pelo comando "prisma migrate dev".
# Normalmente o Prisma cria esse banco sozinho e esta linha pode ficar
# comentada. Ela so e necessaria se o PostgreSQL recusar a criacao automatica
# (ver a secao "Problemas conhecidos" do README).
SHADOW_DATABASE_URL="postgresql://reviva:reviva123@localhost:5432/reviva_shadow?schema=public"

# Chave secreta que assina os tokens JWT do login.
JWT_SECRET="reviva-chave-secreta-de-desenvolvimento-local"

# Por quanto tempo o token continua valido depois do login.
JWT_EXPIRES_IN="7d"

# Porta em que a API vai rodar.
PORT=3000

# Endereco do frontend. Hoje o CORS libera qualquer porta do localhost
# (ver src/app.js), entao esta variavel serve apenas de referencia.
FRONTEND_URL="http://localhost:5173"
